// The tables of the app's database, as the app reads and writes them through Prisma Client (src/server). They are made
// by the SQL migrations in db/migrations, which Prisma Migrate applies (npm run db:migrate: prisma migrate deploy). A
// change of a table is a new migration there and the same change here, and npm run verify fails when the two differ
// (the CHECK constraints of the migrations are not shown here). How to write one: docs/development.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// One row per account: its lists, packs, devices and interests. revision goes up with every save, so that a save of
// stale data is a conflict (409) instead of an overwrite.
model Workspace {
  ownerId   String   @id @map("owner_id")
  lists     Json     @default("[]")
  // The packs; null for data saved before packs, which the app converts when it reads it.
  packs     Json?
  devices   Json     @default("[]")
  // The interests the account chose; null when none were saved.
  interests Json?
  revision  Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Whether the records are in typle_records rather than in the lists (each list's records is then empty).
  recordsSplit Boolean @default(false) @map("records_split")

  @@map("typle_workspaces")
}

// A practice record of a list, kept out of the list's records array. data is the record as the list holds it, with its
// id; position is its place in that array and at its date.
model Record {
  ownerId  String   @map("owner_id")
  listId   String   @map("list_id")
  recordId String   @map("record_id")
  position Int
  at       DateTime @db.Timestamptz(6)
  data     Json

  @@id([ownerId, listId, recordId])
  @@index([ownerId, listId, at(sort: Desc)], map: "typle_records_list_at")
  @@map("typle_records")
}

// When an account last signed out of every device: its logins made no later than revokedAt are refused.
model SessionRevocation {
  ownerId   String   @id @map("owner_id")
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)

  @@map("typle_session_revocations")
}

// One measured save (TYPLE_MEASURE_SAVES=1, docs/save-metrics.md); rows older than 90 days are deleted.
model SaveMetric {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now()) @db.Timestamptz(6)
  operation     String
  status        Int
  durationMs    Int      @map("duration_ms")
  requestBytes  Int      @map("request_bytes")
  responseBytes Int      @map("response_bytes")

  @@index([at], map: "typle_save_metrics_at")
  @@map("typle_save_metrics")
}

// An account of the password login. Not read by the app yet (migration 0039).
model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginId         String       @unique @map("login_id")
  email           String
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String       @map("password_hash")
  locale          String
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  emailTokens     EmailToken[]

  @@index([email], map: "typle_users_email_idx")
  @@map("typle_users")
}

// A token sent by email to verify an address or reset a password (kind 'verify' or 'reset'), kept as its hash.
model EmailToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  kind      String
  email     String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "typle_email_tokens_user_idx")
  @@map("typle_email_tokens")
}

// How often a key (an action and a client) was used in its window, for the password login's limits.
model AuthLimit {
  key          String    @id
  count        Int
  windowStart  DateTime  @map("window_start") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@map("typle_auth_limits")
}

// A Sparklingstadt ID (its sub) linked to the account of another login, so that signing in with the ID opens that
// account (npm run sid:link).
model SidLink {
  sub       String   @id
  accountId String   @unique @map("account_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("typle_sid_links")
}
