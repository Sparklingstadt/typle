# Server-only settings. Put actual values in .env.local or Vercel.
DATABASE_URL=
# Optional direct connection for migrations (Neon).
DIRECT_URL=
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Optional: the GitHub OAuth App. Without both, only signing in with GitHub is unavailable (the ID and password login and
# the local login work).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional: Sparklingstadt ID (OpenID Connect). Without all three, only signing in with it is unavailable. The issuer is
# https://id.sparklingstadt.com; the client is registered there with <AUTH_URL>/api/auth/callback/sid.
AUTH_SID_ISSUER=
AUTH_SID_ID=
AUTH_SID_SECRET=
# The URL the app is served at: it is the GitHub OAuth callback's origin,
# the only origin a save may come from, and (http or https) what names the login cookie.
AUTH_URL=http://localhost:3000
# Optional absolute URL of the site for social preview images; defaults to AUTH_URL, then the Vercel production URL.
SITE_URL=

# The shared demo account ("デモアカウントで試す" on the sign-in page): 1 turns it on, in production too.
DEMO_LOGIN=0
# The secret Vercel Cron sends (Authorization: Bearer) to /api/demo/reset, which puts the demo account's data back
# every day. Without it the reset is refused.
CRON_SECRET=

# Opt in only for a loopback development server; disabled in production.
LOCAL_DEVELOPMENT_LOGIN=0

# Optional LAN access: private IPv4 matching AUTH_URL; unset by default.
LOCAL_DEVELOPMENT_LAN_HOST=
